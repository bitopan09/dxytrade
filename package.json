{
  "name": "dxytrade",
  "version": "1.0.0",
  "description": "DXY trading bot with 9-factor confluence strategy",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm install && cd frontend && npm install && npm run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "setup": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^9.4.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "recharts": "^3.8.1",
    "technicalindicators": "^3.1.0",
    "ws": "^8.16.0",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
