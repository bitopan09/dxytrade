PORT=5002
NODE_ENV=development
TIMEZONE=Asia/Kolkata

# Email Configuration (for trade alerts & daily summaries)
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password
NOTIFY_EMAIL=your@gmail.com

# Bot Risk Management Settings
BOT_ENABLED=true
DAILY_TRADE_LIMIT=1
CONFLUENCE_THRESHOLD=6
RISK_PER_TRADE_PERCENT=1

# Data Feed URLs & Configurations
CFTC_COT_URL=https://www.cftc.gov/dea/newcot/f_disagg.txt
FF_CALENDAR_RSS=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Notification Settings
SEND_EMAIL_ON_TRADE=false
SEND_DAILY_SUMMARY=false
SEND_ERROR_ALERTS=false
